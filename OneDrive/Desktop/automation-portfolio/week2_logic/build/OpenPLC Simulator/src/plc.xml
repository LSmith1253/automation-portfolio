    <pous>
      <pou name="main" pouType="program">
        <interface>
          <inputVars>
            <variable name="Input1">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="Input2">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="Start">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="Stop">
              <type>
                <BOOL/>
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Output1">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="Output2">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="Motor">
              <type>
                <BOOL/>
              </type>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[Output1 := Input1 AND Input2;

(* This turns Output1 ON only when both Input1 AND Input2 are ON *)
(* Like a safety interlock - both doors must be closed before motor starts *)

(* OR Logic - Output2 turns ON when EITHER Input1 OR Input2 is ON *)
Output2 := Input1 OR Input2;

(* Latch circuit - START button turns motor on, STOP turns it off *)
(* Motor holds itself on even after START is released *)
IF Start AND NOT Stop THEN
    Motor := TRUE;
ELSIF Stop THEN
    Motor := FALSE;
END_IF;]]></xhtml:p>
          </ST>
        </body>
        <documentation>
          <xhtml:p><![CDATA[ ]]></xhtml:p>
        </documentation>
